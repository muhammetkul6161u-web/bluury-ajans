# Bu dosyayı backend/.env olarak kopyalayıp değerleri sunucuda doldurun. .env dosyası git'e eklenmez.
PORT=
# Uzun ve rastgele: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DATABASE_URL=
CLIENT_URL=

# Yönetici girişi. Şifre burada düz metin olarak tutulmaz; hash'i şu komutla üretin:
#   node scripts/hash-password.js
# Çıkan satırı tek tırnaklarla birlikte yapıştırın: ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Yönetici oturum süresi (saat). Boşsa 2 saat.
SESSION_HOURS=

# İletişim formu mesajlarının saklama süresi (gün). Boşsa otomatik silme yapılmaz.
MESSAGE_RETENTION_DAYS=
